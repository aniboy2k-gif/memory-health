# cap-constants.env — MEMORY.md 캡 임계 SSOT (CSR #1825)
#
# ★ 단위 = 문자(UTF-16 code unit). 바이트가 아니다.
#   행동 실험으로 확정(2026-08-10, Claude Code 2.1.226):
#     24,900자 → 전문 로드 / 25,100자 → 꼬리 절단        (경계 25,000자)
#     31,534바이트(10,734자) → 전문 로드                  (바이트 캡 없음)
#     302줄(16,534자) → 절단                              (줄 캡 200 독립 실재)
#   재현 = tests/cap-boundary-probe.sh
#
# ★ 이 파일은 source 되지 않는다. 소비자는 `grep '^KEY=' | head -1 | cut -d= -f2` 로 파싱하고
#   정수가 아니면 내장 기본값으로 폴백한다(외부 파일의 코드 실행 회피 · 파싱 오류 내성).
#   따라서 값은 **정수만** 쓴다. 비율(0.8/0.7)을 여기 두지 않고 계산 결과를 직접 적는다.
#
# ★ 경고·목표 임계(0.8 / 0.7)는 **우리 선택**이지 플랫폼이 보증한 값이 아니다.
#   바이너리에서 sYy=0.8 / IVd=0.7 을 관측했으나, 경고는 절단을 일으키지 않으므로
#   행동 실험으로 확인할 수 없었다. 플랫폼 권위를 주장하지 않는다.

MEMORY_CHAR_CAP=25000
MEMORY_CHAR_WARN=20000
MEMORY_CHAR_TARGET=17500

MEMORY_LINE_CAP=200
MEMORY_LINE_WARN=160
MEMORY_LINE_TARGET=140

# 캡 의미를 행동 실험으로 확인한 플랫폼 버전 (기록 전용).
# ★ 런타임 STALE 감지기는 두지 않는다 — 버전 변경은 캡 의미 변경의 약한 신호이기 때문이다
#   (버전이 올라도 캡이 그대로일 수 있고, 안 올라도 바뀔 수 있다).
#   재검증은 릴리스/체크리스트 시 tests/cap-boundary-probe.sh 를 수동 실행한다.
VERIFIED_ON=2.1.226
VERIFIED_BY=behavioral:tests/cap-boundary-probe.sh
SOURCE=docs:code.claude.com/docs/en/memory + behavioral probe (CSR #1825)
